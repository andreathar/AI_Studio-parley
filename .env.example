# ==============================================================================
# Agent Parley Environment Configuration
# ==============================================================================

# Network Server Configuration
# NOTE: 'HOST' is the network interface to bind to (0.0.0.0 listens on all interfaces).
# It is NOT a secret key, password, or token.
PORT=3000
HOST=0.0.0.0

# Optional Authentication & Webhook Secrets
# If your external webhook integration or MCP hook client requires an HMAC secret,
# specify any random 32+ character string here (or generate one in the dashboard):
MCP_SHARED_SECRET=

# Optional Integration Tokens
# Server-side Gemini API key for automated prompt evaluation and assistant features:
GEMINI_API_KEY=

# Personal Access Token for GitHub pull request status, check runs, and issue sync:
GITHUB_TOKEN=

# Optional: SQLite persistence DB path (default: data/agent-parley.sqlite3 in project root)
# AGENT_PARLEY_DB_PATH=

# Required for write routes (POST/DELETE, MCP mutating tools, diagnostics):
# MCP_SHARED_SECRET must be set, otherwise writes fail closed with 503.
# Optional extra CORS origins (comma-separated); default allows only
# http://127.0.0.1:3000 and http://localhost:3000
# AGENT_PARLEY_CORS_ORIGINS=

# Optional Anthropic API key used by diagnostics status (name only here):
# ANTHROPIC_API_KEY=
